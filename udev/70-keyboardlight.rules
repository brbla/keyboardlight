# KeyBoardLight: user access to keyboard config interfaces (hidraw) for WebHID / hidapi
# Yenkee YKB 30 Odyssey (Telink 320f:5055)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="320f", ATTRS{idProduct}=="5055", MODE="0660", TAG+="uaccess"
